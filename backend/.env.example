# Chọn đúng một provider: byteplus, groq hoặc cloudflare
LLM_PROVIDER=byteplus

# BytePlus ModelArk (giữ nguyên cách gọi hiện tại)
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=deepseek-v4-flash-260731
# BYTEPLUS_CODE_CURATOR_MODEL=
# BYTEPLUS_CHALLENGER_MODEL=
BYTEPLUS_REASONING_EFFORT=minimal

# Groq (chỉ được dùng khi LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_CODE_CURATOR_MODEL=
GROQ_REASONING_EFFORT=low

# Cloudflare Workers AI (chỉ được dùng khi LLM_PROVIDER=cloudflare)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_CODE_CURATOR_MODEL=
CLOUDFLARE_MAX_TOKENS=4096

# Semantic embedding dùng riêng cho retrieval, không chiếm context của model chat
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=20
# Chỉ gửi top-3 vào prompt; backend vẫn giữ toàn bộ codebook để kiểm tra collision.
CODE_CANDIDATE_LIMIT=3
# Biến tương thích cấu hình cũ, không còn ép gửi toàn bộ codebook cho LLM.
CODEBOOK_FULL_SCAN_LIMIT=20
# Ngưỡng vận hành tạm thời; hiệu chỉnh lại sau khi có nhãn chuyên gia.
AUTO_MATCH_RETRIEVAL_FLOOR=0.60
AUTO_MATCH_SEMANTIC_FLOOR=0.70
AUTO_MATCH_MARGIN_FLOOR=0.08
AUTO_MATCH_GOAL_FLOOR=0.20
AUTO_MATCH_STRUCTURAL_FLOOR=0.20
CHALLENGED_MATCH_RETRIEVAL_FLOOR=0.50
CHALLENGED_MATCH_SEMANTIC_FLOOR=0.70
CHALLENGED_MATCH_MARGIN_FLOOR=0.08
CENTROID_RETRIEVAL_ENABLED=false
CENTROID_DRIFT_COSINE_FLOOR=0.7
# Chỉ gom cụm đề xuất để kiểm toán; KHÔNG phải ngưỡng tự gắn mã.
CLUSTER_PROPOSAL_SIMILARITY_FLOOR=0.9

# Bài được commit trước, worker đọc hàng đợi từ PostgreSQL.
ASYNC_PROCESSING_ENABLED=true
PROCESSING_WORKER_COUNT=2
PROCESSING_POLL_SECONDS=2
PROCESSING_LEASE_SECONDS=600
PROCESSING_MAX_ATTEMPTS=3
# POST submit chờ worker để giữ màn hình AI thinking; hết hạn thì người dùng có thể F5 sau.
SUBMIT_WAIT_SECONDS=240
SUBMIT_WAIT_POLL_SECONDS=0.5
CODEBOOK_RECHECK_LIMIT=3
RESOLVER_MAX_ATTEMPTS=3
RESOLVER_RETRY_SECONDS=15
MAPPING_BATCH_SIZE=3
NOVELTY_CANDIDATE_LIMIT=12
LLM_TIMEOUT_SECONDS=60
SURVEY_SESSION_REQUIRED=true
PARTICIPANT_TOKEN_REQUIRED=true
SURVEY_GRACE_SECONDS=60
# PILOT khi nghiệm thu; SURVEY khi bắt đầu thu mẫu chính thức.
SURVEY_DATA_SOURCE=PILOT
AUTO_CODE_AUDIT_ENABLED=true
SCOPE_AUDIT_MAX_CASES=80
LLM_EXTRACTION_MAX_TOKENS=3072
LLM_CURATOR_MAX_TOKENS=3072
LLM_CHALLENGER_MAX_TOKENS=3072
LLM_SCORING_MAX_TOKENS=3072
LLM_AUX_MAX_TOKENS=3072
LLM_MAX_RETRIES=1
STORE_RAW_LLM_RESPONSE=false

MAPPING_TEMPERATURE=0.1
CODE_CURATOR_TEMPERATURE=0.1
SCORING_TEMPERATURE=0.4
SCORING_RUNS=1

# Bộ án lệ provisional; đặt false để chạy đối chứng không few-shot
REFERENCE_CASES_ENABLED=true
REFERENCE_CASES_LIMIT=2
REFERENCE_CASES_MAX_CHARS=2200

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aut
JWT_SECRET=change-me
PARTICIPANT_EMAIL_SECRET=change-me-and-keep-stable
CORS_ORIGINS=http://localhost:5173
MOCK_MODE=true
